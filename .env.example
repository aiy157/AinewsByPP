# ==============================================================================
# Ainews - Environment Variables Template
# Copy this file to .env and fill in your credentials
# ==============================================================================

# --- 1. Anthropic API & Model Configuration ---
ANTHROPIC_API_KEY=sk-ant-...
STAGE1_MODEL=claude-haiku-5-5
STAGE2_MODEL=claude-sonnet-5-5
STAGE2_THINKING_BUDGET=4000

# Timeout for Batch API polling before Option 3B Fallback to Standard API (seconds)
# 04:15 ICT -> 05:00 ICT window = 45 mins (20 mins Stage 1 + 20 mins Stage 2)
BATCH_STAGE1_TIMEOUT_SECONDS=1200
BATCH_STAGE2_TIMEOUT_SECONDS=1200
BATCH_POLL_INTERVAL_SECONDS=30

# --- 2. Supabase Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key
SUPABASE_ANON_KEY=your-supabase-publishable-key

# --- 3. Reddit OAuth2 API Configuration (Option A: oauth.reddit.com) ---
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# --- 4. Pipeline Quotas, Timezone & Image Extraction ---
TIMEZONE=Asia/Bangkok
DEFAULT_LOOKBACK_HOURS=28
DEDUP_LOOKBACK_DAYS=7
MAX_VERIFIED_ITEMS=125
MAX_RUMOR_ITEMS=25
STAGE1_MAX_INPUT_TOKENS_PER_CHUNK=100000
REDDIT_MIN_SCORE=20
REDDIT_MIN_COMMENTS=5
ENABLE_OG_IMAGE_FETCH=true
OG_IMAGE_TIMEOUT_SECONDS=5.0
OG_IMAGE_MAX_FETCHES=45

# --- 4. Frontend Vite Environment Variables (Public Read-Only) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
